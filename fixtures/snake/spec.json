      "code": "var N=12,s,dir,next,food,score,alive,games=0;\nvar D={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]},BACK={up:\"down\",down:\"up\",left:\"right\",right:\"left\"};\nfunction hit(p){return s.some(function(c){return c.x===p.x&&c.y===p.y})}\nfunction place(){if(score===0){food={x:8,y:6};return}do{food={x:Math.floor(game.random()*N),y:Math.floor(game.random()*N)}}while(hit(food))}\nfunction show(){game.state={score:score,alive:alive,dir:next,games:games,length:s.length}}\nfunction reset(){s=[{x:4,y:6},{x:3,y:6},{x:2,y:6}];dir=next=\"right\";score=0;alive=true;games++;place();show()}\nfunction turn(d){if(alive&&D[d]&&d!==BACK[dir]){next=d;show()}}\ngame.on(\"swipe\",turn);\ngame.on(\"tap\",function(){if(!alive)reset()});\ngame.on(\"input\",function(name,v){if(name!==\"press\"||!v||!v.length)return;var last=v[v.length-1];if(last===\"go\"){if(!alive)reset()}else turn(last)});\ngame.start({rate:6,setup:reset,\nstep:function(){if(!alive)return;dir=next;var h={x:s[0].x+D[dir][0],y:s[0].y+D[dir][1]};\nif(h.x<0||h.y<0||h.x>=N||h.y>=N||hit(h)){alive=false;show();game.emit(\"over\",{score:score});return}\ns.unshift(h);if(h.x===food.x&&h.y===food.y){score++;place()}else s.pop();show()},\ndraw:function(g,w,h){var c=Math.min(w,h)/N;g.fillStyle=\"#0b1d1a\";g.fillRect(0,0,w,h);g.fillStyle=\"#f59e0b\";g.fillRect(food.x*c+2,food.y*c+2,c-4,c-4);\ng.fillStyle=alive?\"#14b8a6\":\"#64748b\";s.forEach(function(p){g.fillRect(p.x*c+1,p.y*c+1,c-2,c-2)});\nif(!alive){g.fillStyle=\"#ffffff\";g.font=\"bold \"+Math.round(c*0.9)+\"px system-ui\";g.textAlign=\"center\";g.fillText(\"Tap to play again\",w/2,h/2)}}});"
    }
