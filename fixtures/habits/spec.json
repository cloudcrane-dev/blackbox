  "logic": {
    "consts": {},
    "functions": {
      "nextStreak": {
        "params": ["cur", "gap"],
        "cel": "gap <= 0 ? (cur > 0 ? cur : 1) : gap == 1 ? cur + 1 : 1"
      },
      "streakStep": {
        "params": ["acc", "day"],
        "cel": "cel.bind(n, acc.last == null ? 1 : nextStreak(acc.streak, daysBetween(acc.last, day)), {'streak': n, 'best': acc.best > n ? acc.best : n, 'last': day})"
      },
      "streakFromHistory": {
        "params": ["checkins", "today", "storedBest"],
        "cel": "cel.bind(acc, fold(checkins.filter(d, d <= today), {'streak': 0, 'best': storedBest, 'last': null}, 'streakStep'), {'streak': acc.last == null || daysBetween(acc.last, today) > 1 ? 0 : acc.streak, 'best': acc.best, 'risk': acc.last != null && daysBetween(acc.last, today) == 1})"
      },
      "checkins": {
        "params": ["days"],
        "cel": "days.filter(d, days[d].size() > 0 && days[d].all(e, e.done)).sort()"
      },
      "dayStatus": {
        "params": ["days", "d", "today"],
        "cel": "!(d in days) || days[d].size() == 0 ? 'none' : days[d].all(e, e.done) ? 'complete' : d == today ? 'active' : days[d].exists(e, e.done) ? 'partial' : 'incomplete'"
      }
    },
    "computed": {
      "/computed/streak": "streakFromHistory(checkins(saved.days), today, saved.best)",
      "/computed/streakText": "cel.bind(s, streakFromHistory(checkins(saved.days), today, saved.best), string(s.streak) + (s.streak == 1 ? ' day' : ' days') + ' in a row')",
      "/computed/streakNote": "cel.bind(s, streakFromHistory(checkins(saved.days), today, saved.best), s.risk ? \"Finish today's habits to keep it going.\" : 'Best ' + string(s.best))",
      "/computed/dayStatus": "dateRange(addDays(today, -13), addDays(today, 1)).map(d, {'day': d, 'status': dayStatus(saved.days, d, today)})",
      "/computed/ifToday": "ui.selected == today ? [{'shown': true}] : []",
      "/computed/isPast": "ui.selected != today ? [{'shown': true}] : []",
      "/computed/planTitle": "ui.selected == today ? \"Today's habits\" : 'Habits on ' + ui.selected",
      "/computed/empty": "ui.day.size() == 0 ? [{'text': ui.selected == today ? 'Nothing planned yet. Add your first habit.' : 'No habits this day.'}] : []",
      "/saved/best": "cel.bind(s, streakFromHistory(checkins(saved.days), today, saved.best), s.best > saved.best ? s.best : saved.best)"
    },
    "vectors": [
      {
        "fn": "nextStreak",
        "in": [3, 1],
        "out": 4,
        "from": "hint"
