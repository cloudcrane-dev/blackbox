{
  "name": "blackbox",
  "private": true,
  "type": "module",
  "description": "Turn an app's code into a CloudCrane app spec with no code in it, and build that spec into the same app every time.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
